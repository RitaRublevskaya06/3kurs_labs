    {
      "name": "2. Запросы через API Gateway",
      "item": [
        {
          "name": "Gateway - GET /api (→ Server X)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has Nick X\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.Nick).to.eql(\"X\");",
                  "    pm.expect(jsonData.Method).to.eql(\"GET\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
