{
  "info": {
    "name": "GO06_01 Celebrities API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Get All Celebrities",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/Celebrities/All",
          "host": ["{{baseUrl}}"],
          "path": ["Celebrities", "All"]
        }
      }
    },
    {
      "name": "Get Celebrity By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/Celebrities/1",
          "host": ["{{baseUrl}}"],
          "path": ["Celebrities", "1"]
        }
      }
    },
    {
      "name": "Create Celebrity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 3,\n  \"fullName\": \"Tom Hanks\",\n  \"nationality\": \"American\",\n  \"reqPhotoPath\": \"/images/hanks.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/Celebrities",
          "host": ["{{baseUrl}}"],
          "path": ["Celebrities"]
        }
      }
    },
    {
      "name": "Update Celebrity",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 3,\n  \"fullName\": \"Thomas Jeffrey Hanks\",\n  \"nationality\": \"American\",\n  \"reqPhotoPath\": \"/images/thomas_hanks.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/Celebrities/3",
          "host": ["{{baseUrl}}"],
          "path": ["Celebrities", "3"]
        }
      }
    },
    {
      "name": "Delete Celebrity",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/Celebrities/3",
          "host": ["{{baseUrl}}"],
          "path": ["Celebrities", "3"]
        }
      }
    }
  ]
}