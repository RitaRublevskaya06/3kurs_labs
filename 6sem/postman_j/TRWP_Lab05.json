  "item": [
    {
      "name": "1. Round Robin Balancer",
      "item": [
        {
          "name": "GET /lb (10 запросов)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "console.log(`Сервер: ${response.Nick}, Метод: ${response.Method}, Задержка: ${response.Delay}ms`);",
                  "",
                  "// Сбор статистики",
                  "let stats = pm.collectionVariables.get('roundRobinStats') || {};",
                  "stats[response.Nick] = (stats[response.Nick] || 0) + 1;",
                  "pm.collectionVariables.set('roundRobinStats', stats);",
                  "",
                  "pm.test(`Запрос обработан сервером ${response.Nick}`, () => {",
                  "    pm.expect(response.Nick).to.be.oneOf(['X', 'Y', 'Z']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/lb",
