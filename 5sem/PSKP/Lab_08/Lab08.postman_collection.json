      "name": "01 - Connection",
      "item": [
        {
          "name": "Get KeepAliveTimeout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/connection",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["connection"]
            }
          }
        },
        {
          "name": "Set KeepAliveTimeout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/connection?set=5000",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["connection"],
              "query": [
                {
                  "key": "set",
                  "value": "5000"
                }
              ]
            }
          }
        }
      ]
    },
